# 새 설치에서만 이 파일을 .env 또는 .env.local 로 복사한 뒤 값을 채워 주세요.
# 현재 서버에 .env가 있다면 그대로 유지하세요. 예시 파일로 덮어쓰지 않습니다.
# .env 및 .env.local 은 Git에 올라가지 않습니다.

# [필수] Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 Gemini API 키
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# [선택] 사용할 Gemini 모델. URL Context, Google 검색, 구조화된 출력을 지원하는 모델이어야 합니다.
GEMINI_MODEL=gemini-3.8-flash

# [선택] 광고 페이지를 읽는 방식
#   url-context : Gemini URL Context로 페이지를 읽고, 서버가 직접 수집한 본문과 인용문을 대조 (기본값)
#   direct      : 서버가 직접 수집한 본문만 사용하고, 수집에 실패했을 때만 URL Context 사용 (더 빠르고 저렴)
# PAGE_READER=url-context

# [선택] 접속 IP 한 곳당 분석 요청 제한
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=60

# [선택] 서버 프로세스 한 개의 전체 분석 동시 실행·대기 한도
# 동시 실행은 기본 3건(최대 8), 추가 대기는 기본 12건(최대 50), 대기 시간은 최대 2분입니다.
# 같은 인터넷망에서는 IP별 요청 제한을 함께 적용받습니다.
# ANALYSIS_CONCURRENCY=3
# ANALYSIS_QUEUE_LIMIT=12

# 포트는 호스팅 패널의 PORT / SERVER_PORT 설정을 사용합니다. 기본값은 25860입니다.
# 포트 값을 이 파일에 추가하지 마세요. index.js는 Next.js가 .env를 읽기 전에 포트를 선택합니다.
